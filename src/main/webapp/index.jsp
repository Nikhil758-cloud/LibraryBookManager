<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,com.booktracker.model.*" %>
<% List<Book> books=(List<Book>)request.getAttribute("books"); List<Borrower> borrowers=(List<Borrower>)request.getAttribute("borrowers"); List<Issue> issues=(List<Issue>)request.getAttribute("issues"); String message=(String)session.getAttribute("message"),error=(String)session.getAttribute("error"); session.removeAttribute("message");session.removeAttribute("error"); String today=java.time.LocalDate.now().toString(); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Book Issue Tracker</title>
<style>
:root{--navy:#172554;--blue:#3157d5;--bg:#f4f7fb;--ink:#172033;--muted:#68758a;--line:#e5eaf2}*{box-sizing:border-box}body{margin:0;background:var(--bg);font:15px/1.5 Arial,Helvetica,sans-serif;color:var(--ink)}header{background:linear-gradient(120deg,#172554,#3157d5);color:#fff;padding:27px max(22px,calc((100% - 1180px)/2));}header h1{margin:0;font-size:27px}header p{margin:5px 0 0;color:#dbe5ff}.wrap{max-width:1180px;margin:25px auto;padding:0 18px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-bottom:22px}.stat,.panel{background:white;border:1px solid var(--line);border-radius:13px;box-shadow:0 4px 16px #17255408}.stat{padding:19px}.stat span{color:var(--muted);font-size:13px}.stat strong{display:block;font-size:29px;margin-top:4px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-bottom:20px}.panel{padding:20px;min-width:0}.panel h2{font-size:18px;margin:0 0 16px}.field{margin-bottom:12px}.field label{display:block;font-size:13px;font-weight:bold;margin-bottom:5px;color:#48546a}input,select{width:100%;padding:10px 11px;border:1px solid #d8dfeb;border-radius:7px;font:inherit;background:#fff}input:focus,select:focus{outline:2px solid #c7d2fe;border-color:var(--blue)}button{border:0;border-radius:7px;padding:10px 14px;background:var(--blue);color:white;font-weight:bold;cursor:pointer}button:hover{filter:brightness(.93)}.notice{padding:12px 15px;border-radius:8px;margin-bottom:16px}.success{background:#dcfce7;color:#166534}.error{background:#fee2e2;color:#991b1b}.tablepanel{padding:20px;margin-bottom:24px;overflow:hidden}.tablehead{display:flex;justify-content:space-between;align-items:center;gap:12px}.tablehead h2{margin:0 0 14px}.scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;white-space:nowrap;font-size:13px}th,td{text-align:left;padding:12px 11px;border-bottom:1px solid var(--line)}th{color:#596579;background:#f8fafc;font-weight:bold}tbody tr:hover{background:#fafcff}.pill{display:inline-block;padding:4px 9px;border-radius:99px;font-size:11px;font-weight:bold}.issued{background:#ffedd5;color:#9a3412}.returned{background:#dcfce7;color:#166534}.smallbtn{padding:7px 10px;font-size:12px}.empty{text-align:center;color:var(--muted);padding:22px}@media(max-width:900px){.grid{grid-template-columns:1fr 1fr}.grid .panel:last-child{grid-column:1/-1}}@media(max-width:600px){.grid,.stats{grid-template-columns:1fr}.grid .panel:last-child{grid-column:auto}.wrap{padding:0 12px}.panel{padding:15px}}
</style></head><body><header><h1>📚 Book Issue Tracker</h1><p>Manage your library books, borrowers and returns in one place.</p></header><main class="wrap">
<% if(message!=null){%><div class="notice success"><%=message%></div><%}%><% if(error!=null){%><div class="notice error"><%=error%></div><%}%>
<section class="stats"><div class="stat"><span>Total book titles</span><strong><%=request.getAttribute("bookCount")%></strong></div><div class="stat"><span>Registered borrowers</span><strong><%=request.getAttribute("borrowerCount")%></strong></div><div class="stat"><span>Currently issued</span><strong><%=request.getAttribute("activeCount")%></strong></div></section>
<section class="grid">
<div class="panel"><h2>＋ Add a book</h2><form method="post" action="${pageContext.request.contextPath}/action"><input type="hidden" name="action" value="addBook"><div class="field"><label>Book title *</label><input name="title" maxlength="200" required placeholder="e.g. Wings of Fire"></div><div class="field"><label>Author *</label><input name="author" maxlength="150" required placeholder="Author name"></div><div class="field"><label>ISBN (optional)</label><input name="isbn" maxlength="30" placeholder="Unique ISBN"></div><div class="field"><label>Total copies *</label><input type="number" name="copies" min="1" value="1" required></div><button type="submit">Add book</button></form></div>
<div class="panel"><h2>＋ Register borrower</h2><form method="post" action="${pageContext.request.contextPath}/action"><input type="hidden" name="action" value="addBorrower"><div class="field"><label>Full name *</label><input name="fullName" maxlength="150" required placeholder="Borrower's full name"></div><div class="field"><label>Email</label><input type="email" name="email" maxlength="180" placeholder="name@example.com"></div><div class="field"><label>Phone</label><input name="phone" maxlength="30" placeholder="Phone number"></div><button type="submit">Register borrower</button></form></div>
<div class="panel"><h2>↗ Issue a book</h2><form method="post" action="${pageContext.request.contextPath}/action"><input type="hidden" name="action" value="issueBook"><div class="field"><label>Available book *</label><select name="bookId" required><option value="">Choose a book</option><%for(Book b:books){if(b.getAvailableCopies()>0){%><option value="<%=b.getBookId()%>"><%=b.getTitle()%> — <%=b.getAvailableCopies()%> available</option><%}}%></select></div><div class="field"><label>Borrower *</label><select name="borrowerId" required><option value="">Choose a borrower</option><%for(Borrower b:borrowers){%><option value="<%=b.getBorrowerId()%>"><%=b.getFullName()%></option><%}%></select></div><div class="field"><label>Issue date *</label><input type="date" name="issueDate" value="<%=today%>" required></div><div class="field"><label>Due date *</label><input type="date" name="dueDate" value="<%=java.time.LocalDate.now().plusDays(14)%>" min="<%=today%>" required></div><button type="submit">Record issue</button></form></div></section>
<section class="panel tablepanel"><div class="tablehead"><h2>Book inventory</h2></div><div class="scroll"><table><thead><tr><th>ID</th><th>Title</th><th>Author</th><th>ISBN</th><th>Total</th><th>Available</th></tr></thead><tbody><%if(books.isEmpty()){%><tr><td colspan="6" class="empty">No books yet. Add your first book above.</td></tr><%}for(Book b:books){%><tr><td><%=b.getBookId()%></td><td><strong><%=b.getTitle()%></strong></td><td><%=b.getAuthor()%></td><td><%=b.getIsbn()==null?"—":b.getIsbn()%></td><td><%=b.getTotalCopies()%></td><td><%=b.getAvailableCopies()%></td></tr><%}%></tbody></table></div></section>
<section class="panel tablepanel"><h2>Registered borrowers</h2><div class="scroll"><table><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Phone</th></tr></thead><tbody><%if(borrowers.isEmpty()){%><tr><td colspan="4" class="empty">No borrowers registered yet.</td></tr><%}for(Borrower b:borrowers){%><tr><td><%=b.getBorrowerId()%></td><td><strong><%=b.getFullName()%></strong></td><td><%=b.getEmail()==null?"—":b.getEmail()%></td><td><%=b.getPhone()==null?"—":b.getPhone()%></td></tr><%}%></tbody></table></div></section>
<section class="panel tablepanel"><h2>Issue history &amp; returns</h2><div class="scroll"><table><thead><tr><th>Issue ID</th><th>Book</th><th>Borrower</th><th>Issue date</th><th>Due date</th><th>Return date</th><th>Status</th><th>Action</th></tr></thead><tbody><%if(issues.isEmpty()){%><tr><td colspan="8" class="empty">No issue records yet.</td></tr><%}for(Issue i:issues){%><tr><td>#<%=i.getIssueId()%></td><td><%=i.getBookTitle()%></td><td><%=i.getBorrowerName()%></td><td><%=i.getIssueDate()%></td><td><%=i.getDueDate()%></td><td><%=i.getReturnDate()%></td><td><span class="pill <%=i.getStatus().equals("ISSUED")?"issued":"returned"%>"><%=i.getStatus()%></span></td><td><%if(i.getStatus().equals("ISSUED")){%><form method="post" action="${pageContext.request.contextPath}/action" onsubmit="return confirm('Mark this book as returned?')"><input type="hidden" name="action" value="returnBook"><input type="hidden" name="issueId" value="<%=i.getIssueId()%>"><button class="smallbtn" type="submit">Mark returned</button></form><%}else{%>—<%}%></td></tr><%}%></tbody></table></div></section>
<footer style="text-align:center;color:#778197;padding:5px 0 24px;font-size:12px">Book Issue Tracker · JSP · Servlet · JDBC · MySQL</footer></main></body></html>
